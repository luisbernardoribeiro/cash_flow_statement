# =============================================================================
# Variáveis de ambiente — copia para .env.local (local) e Vercel (produção)
# =============================================================================

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# --- Database direta (Drizzle / postgres-js) ---
# Settings → Database → Connection string → Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Stripe (mais tarde) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Resend (emails transacionais) ---
RESEND_API_KEY=re_...
EMAIL_FROM="MAPA Tesouraria <ola@gestimposto.com>"

# --- Branding (não-secretos, no client) ---
NEXT_PUBLIC_BRAND_NAME="MAPA Tesouraria"
NEXT_PUBLIC_BRAND_PARENT="GI Contabilidade & Consultoria"
NEXT_PUBLIC_CC_NUMBER="32897"

# --- URL pública (importante em produção para emails / OAuth) ---
# Em local: http://localhost:3000
# Em prod:  https://mapa.gestimposto.com (ou o teu Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
